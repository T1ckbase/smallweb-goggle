{
  "$schema": "https://raw.githubusercontent.com/denoland/deno/refs/heads/main/cli/schemas/config-file.v1.json",
  "imports": {
    "smallweb": "https://raw.githubusercontent.com/kagisearch/smallweb/refs/heads/main/smallweb.txt"
  },
  "lint": {
    "rules": {
      "exclude": ["no-explicit-any"]
    }
  },
  "fmt": {
    "indentWidth": 2,
    "lineWidth": 120,
    "proseWrap": "preserve",
    "semiColons": true,
    "singleQuote": true,
    "useTabs": false
  },
  "tasks": {
    "build": "deno run --allow-all build.ts",
    "submit": "deno run --allow-all submit.ts"
  },
  "lock": false
}
